---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <section class="wrap lost">
    <h1 class="display"><span data-split="chars">404</span></h1>
    <p data-reveal data-delay="0.3">Page not found.</p>
    <a href="/" class="pill pill-dark" data-reveal data-delay="0.4">Back home <span class="dot"></span></a>
  </section>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 24px;
  }
  .lost h1 {
    font-size: clamp(96px, 20vw, 260px);
    line-height: 0.8;
  }
  .lost p {
    color: var(--muted);
    margin: 0;
  }
</style>
